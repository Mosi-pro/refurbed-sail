# REFURBED SAIL – configuration. Copy to .env and adjust.

# development | production
RS_ENV=development
# Required in production. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RS_SECRET_KEY=

# SQLite by default (data/refurbed_sail.db). PostgreSQL example:
# RS_DATABASE_URL=postgresql+psycopg://user:password@localhost/refurbed_sail
# RS_DATABASE_URL=

# Public URL of the frontend (used for links, e.g. password reset) and Origin checks.
RS_PUBLIC_BASE_URL=http://localhost:5173
# Additional allowed origins, comma separated (e.g. http://192.168.1.20:5173 for LAN access).
RS_ALLOWED_ORIGINS=

# Listings must be approved by an administrator before they go live.
RS_LISTING_APPROVAL_REQUIRED=true

# Upload limits
RS_MAX_IMAGE_MB=10
RS_MAX_DOCUMENT_MB=15

# Cookies are marked "Secure" automatically in production. Override only if needed.
# RS_COOKIE_SECURE=true

# --- start.sh ---------------------------------------------------------------
# Bind addresses. Use 0.0.0.0 for FRONTEND_HOST to allow access from the local network.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
